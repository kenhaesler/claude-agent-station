{
  "projects": [],
  "_project_fields": {
    "repo": "owner/repo (required)",
    "priority": "high | medium | low",
    "mode": "full | analyze",
    "enabled": true,
    "branch": "main",
    "setup_script": "Commands to run before the agent starts, e.g. 'npm install' or 'pip install -r requirements.txt'",
    "custom_instructions": "Extra instructions appended to the agent prompt"
  },
  "schedule": "1h",
  "models": {
    "employee": "claude-opus-4-6",
    "manager": "claude-sonnet-4-6",
    "analyst": "claude-sonnet-4-6"
  },
  "limits": {
    "max_employee_turns": 200,
    "max_analyst_turns": 50,
    "max_manager_turns": 30,
    "token_limit_daily": 0,
    "token_limit_monthly": 0,
    "token_reserve_percent": 20,
    "max_rejection_retries": 1,
    "session_limit_24h": 50,
    "max_session_percent": 80,
    "max_concurrent_employees": 1,
    "max_employees_per_project": 1,
    "token_budget_strategy": "equal_split"
  },
  "dashboard": {
    "port": 8420,
    "bind": "127.0.0.1",
    "webhook_url": ""
  },
  "notifications": {
    "enabled": true,
    "method": "file",
    "notification_file": "/var/log/claude-agent/notifications.log"
  },
  "logging": {
    "log_dir": "/var/log/claude-agent",
    "digest_dir": "/var/log/claude-agent/digests"
  }
