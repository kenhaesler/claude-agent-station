[Unit]
Description=Claude Agent Station Timer
Documentation=https://github.com/VAMFI/claude-agent-station

[Timer]
# Run every 1 hour
OnCalendar=*-*-* *:00:00

# Catch up after downtime
Persistent=true

# Randomize start within 5 minutes to avoid API thundering herd
RandomizedDelaySec=300

# Don't run within 1 minute of boot (let system stabilize)
OnBootSec=60

[Install]
WantedBy=timers.target
